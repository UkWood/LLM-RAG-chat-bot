# Never put a real API key in this file. Supply LLM_API_KEY through environment secrets.
LLM_BASE_URL=https://api.aitunnel.ru/v1
LLM_MODEL=deepseek-v4.1-flash-1017
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
LLM_JSON_MODE=1
# Only enable for an explicitly configured local HTTP endpoint, never public HTTP.
LLM_ALLOW_LOCAL_HTTP=0
